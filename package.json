{
  "name": "pawetta-agent",
  "version": "1.1.0",
  "description": "Локальный AI-агент Паветта для Windows",
  "main": "main.js",
  "author": "Pawetta",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "pack": "electron-builder --dir --win",
    "icon": "electron scripts/render-icon.js",
    "dist": "npm run icon && electron-builder --win portable && npm run verify:signature",
    "dist:unsigned": "npm run icon && electron-builder --win portable --config.forceCodeSigning=false",
    "verify:signature": "pwsh -NoProfile -File scripts/verify-signature.ps1"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.pawetta.agent",
    "productName": "Паветта Агент",
    "forceCodeSigning": true,
    "asar": true,
    "compression": "maximum",
    "electronLanguages": ["ru", "en-US"],
    "files": [
      "main.js",
      "preload.js",
      "build/icon.png",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": ["portable"],
      "artifactName": "Pawetta-Agent-${version}.${ext}"
    }
  }
}
